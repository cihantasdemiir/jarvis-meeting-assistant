# J.A.R.V.I.S yapılandırması — bu dosyayı .env adıyla kopyalayıp doldurun.
# .env dosyası Git'e eklenmez.

# --- Toplantı ---
MEETING_TITLE=Haftalık Değerlendirme Toplantısı
MEETING_CHAIR=
MEETING_LOCATION=
# PDF'in her sayfasının altbilgisinde ve logo yoksa başlıkta yazılır. Örnek:
# COMPANY_NAME=Örnek Demir Çelik San. ve Tic. A.Ş.
COMPANY_NAME=
# Resmî logo dosyası (PNG tercih; JPG/WEBP de okunur). Oran korunur, gerilmez. Boşsa veya dosya yoksa PDF
# başlığında logo alanı "resmî logo dosyası tanımlanmadı" notuyla işaretlenir. Logo yeniden çizilmez/taklit edilmez.
# Örnek: assets/logo/sirket_logo.png
LOGO_PATH=

# --- Veri dosyaları (proje klasörüne göre) ---
PARTICIPANTS_FILE=data/participants.json
AGENDA_FILE=data/agenda.json
DB_PATH=data/jarvis.db

# --- Uyandırma kelimesi ---
WAKE_WORD=jarvis
# Google'ın "Jarvis" yerine yazdığı biçimler. --voice-test raporundaki önerileri buraya ekleyin.
WAKE_WORD_ALIASES=jarvıs,carvis,cervis,çarvis,jarves,jarviz,javis,carviz,çarviz,jarviş
# Yakın hitaplar (ör. charles): uyandırma kelimesi SAYILMAZ, komut doğrudan çalışmaz; satır transkripte
# yazılır ve geçerli bir komuta benziyorsa yalnızca "Jarvis, evet" onayı istenir. Varsayılan kapalı.
# Toplantıda bu adda bir katılımcı varsa kullanmayın.
WAKE_WORD_NEAR_MISSES=
# Klavye modunda da 'Jarvis' öneki zorunlu olsun mu? (Diğer satırlar transkripte yazılır.)
# Ön ek yerine satır başında '!' de kullanılabilir: "!gündemi oku"
TEXT_MODE_REQUIRE_WAKE=true

# --- Konuşma tanıma ---
# google: Google Web Speech (internet gerekir; ses Google'a gönderilir). whisper: Faz 5.
STT_ENGINE=google
STT_LANGUAGE=tr-TR
STT_TIMEOUT_S=8
# İsteğe bağlı: kendi Google Speech API anahtarınız (boşsa kütüphanenin genel anahtarı kullanılır)
GOOGLE_SPEECH_API_KEY=
# Mikrofon numarası (python main.py --list-mics). Boş = Windows varsayılan mikrofonu
MICROPHONE_INDEX=
# Konuşma algılama: 0 = ortam gürültüsüne göre otomatik eşik. --mic-check önerilen eşiği gösterir.
VAD_THRESHOLD=0
# Bu kadar sessizlik konuşmayı bitirir (ms). Komutlar bölünüyorsa artırın (ör. 1000).
VAD_SILENCE_MS=800
# Bundan kısa sesler (öksürük, tıklama) yok sayılır (ms)
VAD_MIN_SPEECH_MS=300
# Tek konuşma bölütünün azami süresi (sn); daha uzun konuşmalar parçalara bölünür
VAD_MAX_SEGMENT_S=15
# Bölüt sonunda korunan sessizlik (ms). Komutların son hecesi kesiliyorsa ("toplantıyı başl") artırın (ör. 700).
VAD_TAIL_KEEP_MS=500
# Konuşma sürerken eşiğin yüzde kaçı hâlâ konuşma sayılır (bitiş histerezisi). Kelime sonları kesiliyorsa düşürün.
VAD_RELEASE_PERCENT=50
# STT'ye gönderilmeden önce ses bu hıza indirilir (48/44.1 kHz mikrofonlarda yükleme ~3 kat küçülür). 0 = kapalı.
STT_RESAMPLE_HZ=16000
# Bu süreyi (sn) aşan tanımalar günlükte ve test raporunda "YAVAŞ" olarak işaretlenir
STT_SLOW_WARNING_S=4
# İnternet kesintisinde tanınamayan sesleri output/ses_bekleyen/ altına yedekle
SAVE_PENDING_AUDIO=true

# --- Sesli yanıt ---
# pocket  = Pocket TTS Turkish (doğal Türkçe ses; kurulum: pip install -r requirements-tts.txt)
# pyttsx3 = eski Windows SAPI5 motoru (yalnızca açıkça seçilirse)
# none    = yalnızca konsol
# Pocket yüklenemezse uygulama konsolla devam eder; İngilizce sese otomatik geçilmez.
TTS_ENGINE=pocket
TTS_VOLUME_PERCENT=100
# Asistan konuştuktan sonra mikrofonun kendi sesini duymaması için bekleme (ms).
# Hoparlör yüksekse veya Bluetooth hoparlör kullanılıyorsa 1000-1200 deneyin.
TTS_ECHO_GUARD_MS=700

# Pocket TTS Turkish ayarları
TTS_VOICE=male_1
# cpu (önerilen) veya cuda. cuda yalnızca CUDA'lı PyTorch kuruluysa çalışır ve Qwen ile GPU belleğini paylaşır.
TTS_DEVICE=cpu
# Model klasörü (config.yaml, model.safetensors, tokenizer.model, voices/). Boşsa Hugging Face
# önbelleğinde yalnızca YEREL arama yapılır; internetten indirme yalnızca: python main.py --tts-download
TTS_MODEL_DIR=
# 0 = PyTorch varsayılanı. Ses takılırsa veya komutlar yavaşlarsa 2-4 deneyin (python main.py --tts-bench).
TTS_CPU_THREADS=0
TTS_LOAD_TIMEOUT_S=120
# Oynatma başlamadan önce biriktirilen ses (ms)
TTS_PREBUFFER_MS=200
# Bekleyen yanıt sınırı; aşılırsa en eski bekleyen yanıt seslendirilmez (konsolda yine görünür)
TTS_MAX_QUEUE=5
# Daha uzun yanıtların yalnızca başı okunur ("Ayrıntılar ekranda.")
TTS_MAX_SPOKEN_CHARS=500
# Hoparlör aygıt numarası; boşsa Windows varsayılanı
TTS_OUTPUT_DEVICE=
TTS_SHUTDOWN_TIMEOUT_S=15

# Yalnızca TTS_ENGINE=pyttsx3 için
TTS_RATE=165
TTS_VOICE_HINT=tolga

# --- Gündem süreleri ---
DEFAULT_ITEM_MINUTES=10
TIMEBOX_WARNING_PERCENT=80

# --- E-posta ---
# Örnek (Office 365): SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_USE_TLS=true
# Örnek (Gmail):      SMTP_HOST=smtp.gmail.com      SMTP_PORT=587  SMTP_USE_TLS=true  (uygulama şifresi gerekir)
#   Gmail: SMTP_USER = tam Gmail adresi; SMTP_PASSWORD = 2 Adımlı Doğrulama açıkken oluşturulan 16 harfli
#   uygulama şifresi (normal hesap şifresi çalışmaz). Gerçek göndermeden önce: python main.py --smtp-check
# SSL ile 465 portu:  SMTP_PORT=465  SMTP_USE_SSL=true
SMTP_HOST=
SMTP_PORT=587
# Aşağıdakiler ÖRNEK değerlerdir; gerçek bilgilerinizi yalnızca kendi .env dosyanıza yazın.
SMTP_USER=kullanici@example.com
SMTP_PASSWORD=YOUR_APP_PASSWORD
SMTP_FROM=kullanici@example.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30
# Güvenli varsayılan: tutanak otomatik gönderilmez, 'tutanağı gönder' komutu beklenir.
AUTO_SEND_MINUTES=false
# Alıcılar: all = katılımcı listesindeki herkes, present = yalnızca toplantıya katılanlar
MAIL_RECIPIENTS=all
# Yanlış kişiye gönderimi önlemek için izin verilen alan adları (virgülle). Boşsa kısıtlama yok.
# Örnek: MAIL_ALLOWED_DOMAINS=example.com
MAIL_ALLOWED_DOMAINS=
# TEST: doluysa tüm e-postalar yalnızca bu adrese gider ve konuya [TEST] eklenir. Canlı kullanımda boş bırakın.
MAIL_REDIRECT_TO=
# true ise SMTP kullanılmaz; e-posta output/outbox/ altına .eml dosyası olarak yazılır.
MAIL_DRY_RUN=false
# Takvim daveti (.ics): "Jarvis, sonraki toplantı 21 Ekim saat 14.00" ile oluşur (saat söylenmezse oluşmaz).
# Süre söylenmediğinde kullanılan varsayılan (dakika) ve davetin tutanak e-postasına eklenmesi:
ICS_DURATION_MINUTES=60
MAIL_ATTACH_ICS=true

# --- PDF tutanak ---
# Kurumsal ana renk (başlıklar ve tablo başlıkları; HTML e-postanın başlık rengi de budur).
PDF_PRIMARY_COLOR=#1F3A5F
# İnce vurgu rengi (bölüm numaraları, üst şerit) — yalnızca PDF
PDF_ACCENT_COLOR=#197E89
# Türkçe destekli font (boşsa sırasıyla assets/fonts/DejaVuSans.ttf, Windows Arial/Calibri/Segoe UI denenir)
PDF_FONT_REGULAR=
PDF_FONT_BOLD=

# --- İsteğe bağlı LLM özeti (G-15) ---
OPENAI_API_KEY=

# --- Yerel LLM (Ollama) — Faz 5 ---
# Varsayılan KAPALI. Açıkken bile toplantı metni yalnızca bu bilgisayardaki Ollama sunucusuna gider.
LLM_ENABLED=false
OLLAMA_HOST=http://127.0.0.1:11434
# Uygulamanın kullandığı model (karşılaştırma sonucuna göre seçin)
LLM_MODEL=qwen3:4b
# --llm-benchmark ile karşılaştırılacak modeller (virgülle)
LLM_COMPARE_MODELS=qwen3.5:4b,qwen3:4b
# Komut yorumlama etkileşimlidir: bu sürede yanıt gelmezse "anlayamadım" denir (sn)
LLM_ROUTER_TIMEOUT_S=12
# Toplantı analizi / özet için zaman aşımı (sn)
LLM_TIMEOUT_S=180
# Bağlam penceresi (token). 6 GB VRAM'de 4B model için 8192 makul bir başlangıçtır; büyütmek belleği artırır.
LLM_NUM_CTX=8192
LLM_TEMPERATURE=0
# Qwen3 "düşünme" kipi. Kapalı tutmak yanıtı hızlandırır; açmak doğruluğu artırabilir (ölçerek karar verin).
LLM_THINK=false
LLM_KEEP_ALIVE=15m
# Uzak Ollama sunucusu veya "-cloud" modeller yalnızca kurum onayıyla açılmalıdır (toplantı metni dışarı çıkar).
LLM_ALLOW_REMOTE=false
# Jarvis'e açıkça söylenen ama kurallarla anlaşılamayan komutları LLM'ye sor (onaylı)
LLM_ROUTER_ENABLED=true
# "Jarvis, toplantıyı analiz et" komutunda LLM kullan (kapalıysa kural tabanlı taslak çıkarımı)
LLM_ANALYSIS_ENABLED=true
# LLM önerisini "Jarvis, evet" ile onaylama süresi (sn)
LLM_CONFIRM_TIMEOUT_S=60
# Modelin bu güvenin (0-1) altındaki önerileri işleme dönüştürülmez; kullanıcıdan açık komut istenir (Faz 5c.1)
LLM_MIN_CONFIDENCE=0.5
# Uzun toplantılar bu büyüklükte (karakter) parçalara bölünerek analiz edilir
LLM_CHUNK_CHARS=6000

# ---- Çok turlu diyalog (Faz 5c.2) — LLM gerektirmez; sorulara verilen yanıtlar yine onaya gider
DIALOG_ENABLED=true
# Jarvis'in sorduğu sorunun (ör. "Selin Er mi, Selin Uçar mı?") geçerlilik süresi (sn)
DIALOG_TIMEOUT_S=60
# "Jarvis" denmeden verilen kısa yanıtın (evet, aday adı...) kabul edildiği süre (sn); 0 = her yanıtta "Jarvis" gerekir
DIALOG_UNADDRESSED_WINDOW_S=20
# "Jarvis" duyulmadan söylenen komut kalıbı ("Ömer katıldı") transkriptte işaretlenir; önemli olmayan komutsa
# "uygulamamı ister misiniz?" diye sorulur. false = yalnızca işaretlenir, sorulmaz. Hiçbir zaman kendiliğinden çalışmaz.
UNADDRESSED_COMMAND_PROMPT=true

# ---- Sesli yanıtı kesme
# Asistan konuşurken yalnızca "Jarvis, dur / sus / yeter / dinle" dinlenir; başka hiçbir şey komut sayılmaz.
# Gerçek yankı engelleme yoktur: hoparlör mikrofona yakınsa algılanmayabilir (kulaklık önerilir; Esc her zaman çalışır).
BARGE_IN_ENABLED=true
# Kullanıcı sesi, hoparlör yankısının en az bu katı yüksek olmalı (yanlış kesme oluyorsa artırın: 3-4)
BARGE_IN_ECHO_MARGIN=2.5
# Esc tuşu çalan sesli yanıtı keser (Windows konsolu). Ctrl+C uygulamayı kapatır.
KEYBOARD_STOP=true

# ---- Tanılama: her girdinin hangi aşamada (STT → hitap → ayrıştırıcı → diyalog → LLM → işlem) sonuçlandığı
# logs/pipeline_trace.jsonl dosyasına yazılır. Rapor: python main.py --trace-report
PIPELINE_TRACE=true
# true yapılırsa söylenen metin de yazılır (yalnızca kendi bilgisayarınızda hata ayıklarken; toplantı içeriği içerir)
PIPELINE_TRACE_TEXT=false
